# Контекст сборки — только исходники: bin/obj хоста перезаписали бы контейнеровский
# restore (NETSDK1064), секреты и мусор в образ попасть не должны.

# Артефакты сборки хоста (критично: obj/ содержит пути локального NuGet-кеша)
**/bin/
**/obj/

# Git/CI — в образ не нужны
.git/
.github/

# Локальные данные и секреты
App_Data/
tile-cache*/
.env
map-*.png

# IDE и системный мусор
.idea/
**/.DS_Store
*.user
