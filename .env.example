# Шаблон .env для docker compose.
# Проще: сгенерируйте готовый файл — ./tools/generate-env.sh <BOT_TOKEN> <CHAT_ID>
# Формат: переменные окружения перекрывают appsettings.json (разделитель __ = вложенность секций).

Telegram__BotToken=1234567890:AAExample-token_replace-me
Telegram__AllowedChatIds__0=115004568

# Опционально:
# Tcp__Port=5023
# ASPNETCORE_ENVIRONMENT=Production
