<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <UserSecretsId>92dfa4ab-e436-4bc2-a456-ec2adb6b10d4</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="Telegram.Bot" />
  </ItemGroup>

  <!-- Каталог для SQLite-базы: .keep держит его в git, Include — в publish-выходе
       (Docker-том монтируется в существующий каталог, владелец из Dockerfile) -->
  <ItemGroup>
    <None Include="App_Data\.keep" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
